# Vorlage fuer die lokale Konfiguration.
# Als .env in dieses Verzeichnis kopieren und die leeren Werte fuellen.
# .env selbst ist von Git ausgeschlossen; diese Vorlage enthaelt keine Secrets.
#
# Werte koennen alternativ direkt als Umgebungsvariablen gesetzt werden;
# Umgebungsvariablen haben Vorrang vor dieser Datei.

# Pfad der SQLite-Datenbank (relativ zum Startverzeichnis oder absolut).
BULKEDIT_DB_PATH=data/bulkedit.sqlite3

# Pflicht: Fernet-Schluessel fuer die API-Keys in der Datenbank.
# Erzeugen mit: .\.venv\Scripts\python.exe -m app generate-master-key
# Geht der Schluessel verloren, muessen alle API-Keys neu erfasst werden.
BULKEDIT_MASTER_KEY=

# Pflicht: Secret fuer die signierte NiceGUI-Session, mindestens 16 Zeichen.
# Beispiel zum Erzeugen:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
BULKEDIT_STORAGE_SECRET=

# Optional - Standardwerte aus app/settings.py.
# BULKEDIT_SESSION_TIMEOUT_MINUTES=60
# BULKEDIT_LOGIN_MAX_ATTEMPTS=5
# BULKEDIT_LOGIN_WINDOW_SECONDS=300
# BULKEDIT_SCRIPT_TIMEOUT_SECONDS=60
# BULKEDIT_SCRIPT_MAX_OUTPUT_CHARS=20000

# Nur fuer die Phase-1-Pruefungen (python -m app.spike). Getrennt von BULKEDIT_*,
# gehoert nicht zur Anwendung. Werte eines Testsystems, niemals Produktion.
# PXTEST_HOST=beispiel.px.media
# PXTEST_API_KEY=
# PXTEST_COLLECTION_ID=0
# PXTEST_IS_DEV=true
# PXTEST_LEDGER_PATH=data/spike/ledger.json
