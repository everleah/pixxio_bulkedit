# pixx.io Bulk-Editor - Umgebung fuer den VPS
# Kopie als .env neben docker-compose.vps.yml ablegen und alle Werte setzen.

# Image-Tag im Forgejo-Registry (default: latest)
BULKEDIT_TAG=latest

# Oeffentlicher Hostname (Traefik-Routing + Let's Encrypt)
BULKEDIT_HOST=bulkedit.vcs1.him-tools.de

# Externes Traefik-Netz (muss dem Netz entsprechen, an dem Traefik haengt)
TRAEFIK_NETWORK=him-net

# Geheimnisse - vor dem ersten Start erzeugen und dauerhaft behalten!
#
# BULKEDIT_MASTER_KEY: Fernet-Schluessel fuer die API-Keys der Profile.
#   Erzeugen mit: python -m app generate-master-key
#   Aendern macht gespeicherte pixx.io-Keys unlesbar.
# BULKEDIT_STORAGE_SECRET: Signatur der Sitzungs-Cookies, mindestens 16 Zeichen.
#   Erzeugen mit: openssl rand -base64 32
# Datenbank und beide Secrets zusammen sichern (siehe backup.sh).
BULKEDIT_MASTER_KEY=change-me-fernet-key
BULKEDIT_STORAGE_SECRET=change-me-strong-random-value

# Grenzen
BULKEDIT_SESSION_TIMEOUT_MINUTES=60
BULKEDIT_LOGIN_MAX_ATTEMPTS=5
BULKEDIT_SCRIPT_TIMEOUT_SECONDS=60
BULKEDIT_SCRIPT_MAX_OUTPUT_CHARS=20000
